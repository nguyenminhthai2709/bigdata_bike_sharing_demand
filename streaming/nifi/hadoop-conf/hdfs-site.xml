<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phải khớp với HDFS_CONF_* trong hadoop/hadoop.env (dfs.replication=2,
  permissions đã tắt để dev/demo).
-->
<configuration>
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
</configuration>
