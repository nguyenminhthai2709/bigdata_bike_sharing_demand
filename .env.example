# =============================================================================
# FILE MẪU BIẾN MÔI TRƯỜNG.  Người mới làm theo:
#     cp .env.example .env           (Git Bash / Linux / Mac)
#     Copy-Item .env.example .env    (PowerShell)
# rồi mới `docker compose up`. Toàn bộ giá trị dưới đây là DEMO cho local/dev —
# đổi mật khẩu trước khi dùng thật và KHÔNG commit .env chứa secret thật.
# =============================================================================

# ---- PostgreSQL (DB dùng chung + metadata DB cho Airflow) ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=datawarehouse
AIRFLOW_DB=airflow

# ---- Airflow ----
# Linux: nên đặt AIRFLOW_UID = kết quả lệnh `id -u`. Windows/Mac: giữ 50000.
AIRFLOW_UID=50000
AIRFLOW_IMAGE=apache/airflow:2.9.3
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin123

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_DEFAULT_BUCKETS=datalake,spark-warehouse

# ---- Kafka (KRaft mode, không cần Zookeeper) ----
# Bitnami đã gỡ tag `bitnami/kafka:3.7` khỏi Docker Hub (thay đổi Broadcom 8/2025)
# -> dùng namespace `bitnamilegacy` (image đóng băng, giữ nguyên biến KAFKA_CFG_*).
KAFKA_IMAGE=bitnamilegacy/kafka:3.7
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
# Cluster ID: chuỗi UUID base64 16-byte. Giá trị mẫu dùng được ngay; muốn tự sinh:
#   docker run --rm bitnamilegacy/kafka:3.7 kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ---- Hadoop (HDFS + YARN, image bde2020) ----
HADOOP_IMAGE_TAG=2.0.0-hadoop3.2.1-java8
HADOOP_CLUSTER_NAME=bigdata

# ---- NiFi (single-node, HTTPS single-user) ----
NIFI_VERSION=1.28.1
NIFI_USERNAME=admin
# BẮT BUỘC >= 12 ký tự (yêu cầu single-user của NiFi).
NIFI_PASSWORD=nifiadmin12345

# ---- Spark (standalone: 1 master + 2 worker) ----
# Bitnami đã gỡ `bitnami/spark:3.5` -> dùng bản `bitnamilegacy` (pull được từ Hub).
# Image Jupyter build TRÊN image này nên Python luôn khớp với worker.
SPARK_IMAGE=bitnamilegacy/spark:3.5

# ---- JupyterLab + PySpark ----
# Token đăng nhập JupyterLab tại http://localhost:8888
JUPYTER_TOKEN=bigdata
